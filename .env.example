# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=fire_extinguisher_system

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=7d

# Auth Service
AUTH_SERVICE_PORT=4001
AUTH_SERVICE_URL=http://localhost:4001

# Customer Service
CUSTOMER_SERVICE_PORT=4002
CUSTOMER_SERVICE_URL=http://localhost:4002

# Extinguisher Service
EXTINGUISHER_SERVICE_PORT=4003
EXTINGUISHER_SERVICE_URL=http://localhost:4003

# Notification Service
NOTIFICATION_SERVICE_PORT=4004
NOTIFICATION_SERVICE_URL=http://localhost:4004

# Compliance Service
COMPLIANCE_SERVICE_PORT=4005
COMPLIANCE_SERVICE_URL=http://localhost:4005

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@fire-system.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
NODE_ENV=development
