# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=fire_extinguisher_system

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=7d

# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001

# Customer Service
CUSTOMER_SERVICE_PORT=3002
CUSTOMER_SERVICE_URL=http://localhost:3002

# Extinguisher Service
EXTINGUISHER_SERVICE_PORT=3003
EXTINGUISHER_SERVICE_URL=http://localhost:3003

# Notification Service
NOTIFICATION_SERVICE_PORT=3004
NOTIFICATION_SERVICE_URL=http://localhost:3004

# Compliance Service
COMPLIANCE_SERVICE_PORT=3005
COMPLIANCE_SERVICE_URL=http://localhost:3005

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@fire-system.com

# SMS Configuration
SMS_API_KEY=your-sms-api-key
SMS_PROVIDER=twilio

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
NODE_ENV=development
