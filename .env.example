# Database Configuration (Docker Postgres — published on host port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=fire_extinguisher_system

# JWT Configuration (access token TTL; refresh tokens live longer, server-side)
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=15m

# Auth Service
AUTH_SERVICE_PORT=4001
AUTH_SERVICE_URL=http://localhost:4001

# Extinguisher Service
EXTINGUISHER_SERVICE_PORT=4003
EXTINGUISHER_SERVICE_URL=http://localhost:4003

# Notification Service
NOTIFICATION_SERVICE_PORT=4004
NOTIFICATION_SERVICE_URL=http://localhost:4004

# Compliance Service
COMPLIANCE_SERVICE_PORT=4005
COMPLIANCE_SERVICE_URL=http://localhost:4005

# Unified API documentation (Swagger UI for all services)
API_DOCS_PORT=4010

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@fire-system.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
NODE_ENV=development

# Inspector portal (assignment emails — extinguisher service)
FRONTEND_URL=http://localhost:3000

# Frontend (Vite — copy to apps/frontend/.env)
VITE_AUTH_API=http://localhost:4001
VITE_EXT_API=http://localhost:4003
VITE_REPORTS_API=http://localhost:4005
